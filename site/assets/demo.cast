{"version": 2, "width": 100, "height": 32, "stdout": [[0.0, "$ npx create-dsh-plugin demo-plugin -t tool --yes --verify\r\n"], [0.2747, "\u001b[1G"], [0.0001, "\u001b[0K"], [1.8477, "\r\n"], [0.0001, "\u001b[32m✔ Generated tool plugin in /private/tmp/dsh-demo/demo-plugin (生成完成)\u001b[0m\r\n"], [0.0, "\u001b[2m  template: tool  package: demo-plugin  plugin-id: demo-plugin\u001b[0m\r\n"], [0.0, "\u001b[2m  @deepseek-ai/dsh-tools pinned to 0.1.0-rc.6 (next tag; latest is stale 0.0.1-rc.1)\u001b[0m\r\n"], [0.0, "\u001b[2m  files: .gitignore, README.md, cordis.patch.yml, package.json, src/index.ts, tsconfig.json\u001b[0m\r\n"], [0.0001, "\r\n\u001b[36m✦ --verify — build + install into a temp profile + dump-config\u001b[0m\r\n"], [0.0039, "\u001b[2m\r\n[1/4] pnpm install  →  /private/tmp/dsh-demo/demo-plugin\u001b[0m\r\n"], [4.3522, "\u001b[32m✔ install ok\u001b[0m\r\n\u001b[2m\r\n[2/4] pnpm run build\u001b[0m\r\n"], [0.8815, "\u001b[32m✔ build ok (tsc → dist/)\u001b[0m\r\n\u001b[2m\r\n[3/4] dsh plugin add → temp profile\u001b[0m\r\n"], [0.9245, "\u001b[32m✔ dsh plugin add ok\u001b[0m\r\n\u001b[2m\r\n[4/4] dump-config → check plugin row\u001b[0m\r\n"], [0.9794, "\u001b[32m✔ dump-config contains plugin row \"demo-plugin\"\u001b[0m\r\n\r\n\u001b[32m✔ VERIFY PASSED — the plugin compiles and loads into a real DSH profile (验证通过)\u001b[0m\r\n"], [0.0, "\r\n\u001b[36m下一步 / Next steps:\u001b[0m\r\n"], [0.0, "\u001b[2m  cd demo-plugin\u001b[0m\r\n\u001b[2m  pnpm install && pnpm run build\u001b[0m\r\n"], [0.0, "\u001b[2m  # from the PARENT directory, install into a profile:\u001b[0m\r\n"], [0.0, "\u001b[2m  dsh plugin --profile my-profile add ./demo-plugin\u001b[0m\r\n\u001b[2m  dsh --profile my-profile            # boot and watch the plugin load\u001b[0m\r\n"], [0.0, "\r\n"], [0.0024, "\u001b[1G"], [0.0, "\u001b[0K⠙"], [0.0007, "\u001b[1G\u001b[0K"]]}